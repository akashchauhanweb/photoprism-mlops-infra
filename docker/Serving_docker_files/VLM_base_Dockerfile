# Base image with CUDA 12.1 + cuDNN 8 + Python 3.11 (conda)
FROM pytorch/pytorch:2.5.1-cuda12.1-cudnn9-runtime

# Set working directory (mirrors the jovyan JupyterHub layout)
WORKDIR /home/jovyan/work

# Avoid interactive prompts during apt installs
ENV DEBIAN_FRONTEND=noninteractive

# System dependencies for image processing and git
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    git-lfs \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip

# Core ML / scientific libraries
RUN pip install --no-cache-dir \
    numpy \
    Pillow \
    opencv-python-headless

# HuggingFace stack
# transformers>=4.52 required for Qwen3-VL processor support
RUN pip install --no-cache-dir \
    "transformers>=4.52.0" \
    "accelerate>=0.34.0" \
    "huggingface_hub>=0.23.0" \
    "tokenizers>=0.19.0" \
    "safetensors>=0.4.3" \
    sentencepiece \
    qwen-vl-utils

# Jupyter (matches the JupyterHub environment used in the notebook)
RUN pip install --no-cache-dir \
    jupyterlab \
    ipykernel \
    ipywidgets

# API server dependencies
RUN pip install --no-cache-dir \
    "fastapi>=0.111.0" \
    "uvicorn[standard]>=0.30.0" \
    pydantic

# Clone the Qwen3-VL-Reranker-2B custom scripts repo
# This provides scripts/qwen3_vl_reranker.py used in the notebook
RUN git clone https://github.com/zwq2018/Qwen3-VL-Reranker-2B.git \
    /home/jovyan/work/Qwen3-VL-Reranker-2B

# Copy project files into the image
COPY Base_model.ipynb /home/jovyan/work/Base_model.ipynb
COPY api.py /home/jovyan/work/api.py

# Expose ports: 8888 = Jupyter, 8000 = FastAPI
EXPOSE 8888 8000

# Default: run the FastAPI server
# Override CMD to launch JupyterLab instead if needed:
#   docker run ... jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root
CMD ["python", "/home/jovyan/work/api.py"]
