# CUDA 12.1 + cuDNN 8 base (matches bitsandbytes GPU requirements)
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# --- System deps ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3-pip \
    git \
    wget \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python  python  /usr/bin/python3.11 1

# --- PyTorch (CUDA 12.1 wheel) ---
RUN pip install --upgrade pip && \
    pip install torch torchvision --index-url https://download.pytorch.org/whl/cu121

# --- Clone Qwen3-VL-Reranker repo ---
ARG QWEN_REPO_URL=https://github.com/QwenLM/Qwen3-VL-Reranker-8B.git
ENV QWEN_REPO_PATH=/app/Qwen3-VL-Reranker-8B
RUN git clone --depth 1 ${QWEN_REPO_URL} ${QWEN_REPO_PATH}

# --- Install Qwen repo deps if present ---
RUN if [ -f ${QWEN_REPO_PATH}/requirements.txt ]; then \
        pip install -r ${QWEN_REPO_PATH}/requirements.txt; \
    fi

# --- App deps ---
RUN pip install \
    transformers>=4.40.0 \
    accelerate>=0.27.0 \
    bitsandbytes>=0.43.0 \
    fastapi>=0.111.0 \
    "uvicorn[standard]>=0.29.0" \
    "pydantic>=2.0.0" \
    numpy \
    Pillow \
    sentencepiece \
    tiktoken

WORKDIR /app
COPY api.py .

# --- Runtime env ---
ENV MODEL_NAME=Qwen/Qwen3-VL-Reranker-8B \
    HOST=0.0.0.0 \
    PORT=8000

EXPOSE 8000

# Download model weights at build time (optional — comment out to pull at runtime)
RUN python3 -c "\
from transformers import AutoTokenizer; \
AutoTokenizer.from_pretrained('${MODEL_NAME}')" || true

CMD ["python3", "api.py"]
