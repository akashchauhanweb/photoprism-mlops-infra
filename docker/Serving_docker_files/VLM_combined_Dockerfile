FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# System dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3-pip \
    git \
    wget \
    curl \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

WORKDIR /app

# Clone the Qwen3-VL-Reranker repo (same path as expected in api.py)
RUN git clone https://github.com/QwenLM/Qwen3-VL-Reranker /home/jovyan/work/Qwen3-VL-Reranker-8B

# PyTorch with CUDA 12.1
RUN pip install torch==2.3.1 torchvision==0.18.1 torchaudio==2.3.1 \
    --index-url https://download.pytorch.org/whl/cu121

# Hugging Face + quantization stack
RUN pip install \
    transformers==4.44.2 \
    accelerate==0.33.0 \
    bitsandbytes==0.43.3 \
    safetensors \
    sentencepiece \
    tokenizers

# Qwen3-VL vision dependencies
RUN pip install \
    qwen-vl-utils \
    Pillow \
    opencv-python-headless \
    einops \
    timm

# API server
RUN pip install \
    fastapi==0.111.0 \
    uvicorn[standard]==0.30.1 \
    pydantic==2.7.4

# Install Qwen3-VL-Reranker package dependencies if present
RUN if [ -f /home/jovyan/work/Qwen3-VL-Reranker-8B/requirements.txt ]; then \
        pip install -r /home/jovyan/work/Qwen3-VL-Reranker-8B/requirements.txt; \
    fi

COPY api.py /app/api.py

EXPOSE 8000

CMD ["python", "api.py"]
