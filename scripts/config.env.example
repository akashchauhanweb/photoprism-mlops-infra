# PhotoPrism MLOps — bring_up.sh configuration
# Copy to config.env (gitignored) and fill in per-lease values.

# ---- GPU VM (CHI@UC, fixed lease) ----
RERANKER_IP=""   # left blank; bring_up.sh will prompt
RERANKER_SSH_USER="cc"
RERANKER_SSH_KEY="$HOME/.ssh/id_proj24_gpu"

# ---- Docker Hub ----
DOCKER_HUB_USER="akashweb"
# DOCKER_HUB_PAT lives in k8s/platform/services/dockerhub-sealed-secret.yaml

# ---- Image tags ----
# CPU-cluster services (clip-api, ingest-api, search-api, feature-worker,
# photoprism-ingest) have tags pinned in their k8s YAMLs — edit there.
# Only the GPU VM containers are tag-controlled from this file:
RERANKER_API_TAG="0.1.6"
FEEDBACK_TRAINER_TAG="0.1.9"

# ---- Retrain loop ----
RETRAIN_THRESHOLD="100"
MIN_FEEDBACK_SAMPLES="100"

# ---- Postgres live backup (CronJob) ----
PG_BACKUP_TAG="0.1.1"
POSTGRES_BACKUP_SCHEDULE="*/5 * * * *"
POSTGRES_BACKUP_RETENTION_HOURS="24"

# ---- Paths ----
SEALED_SECRETS_KEY_BACKUP="$HOME/.ssh/sealed-secrets-key-backup.yaml"

# ---- OpenStack (KVM@TACC, for security group creation) ----
OS_CLOUD="openstack"
PHOTOPRISM_IMAGE_TAG="0.2.16"
