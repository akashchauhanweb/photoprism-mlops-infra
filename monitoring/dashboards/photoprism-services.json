    {
      "id": 2,
      "title": "Total request rate (req/s)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PLACEHOLDER"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pp_http_requests_total[5m]))",
          "legendFormat": "Total request rate (req/s)"
        }
      ]
    },
    {
      "id": 3,
      "title": "5xx error rate (%)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PLACEHOLDER"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(pp_http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(pp_http_requests_total[5m])), 1)",
          "legendFormat": "5xx error rate (%)"
        }
      ]
    },
